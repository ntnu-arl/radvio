<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="image_multiplier" default="1"/>
  <arg name="rosbag_in" default="/media/shared/bags/2025_09_26_rvio/manual2/jacamar_2025-09-30-11-19-21_0.bag"/>
  <arg name="rosbag_out" default="/media/shared/bags/2025_09_26_rvio/rovio"/>

  <node pkg="rovio" type="rovio_rosbag_loader" name="rovio" output="screen" clear_params="true">
    <param name="filter_config" value="$(find rovio)/cfg/jacamar/rovio.info"/>
    <param name="camera0_config" value="$(find rovio)/cfg/jacamar/cam0.yaml"/>

    <param name="image_multiplier" value="$(arg image_multiplier)"/>

    <param name="rosbag_filename" value="$(arg rosbag_in)"/>
    <param name="filename_out" value="$(arg rosbag_out)"/>

    <param name="imu_topic_name" value="/vectornav_driver_node/imu/data"/>
    <param name="cam0_topic_name" value="/d455/infra1/image_rect_raw"/>
    <param name="radar_topic_name" value="/radar/cloud"/>
  </node>
</launch>