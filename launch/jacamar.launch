<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <node pkg="rovio" type="rovio_node" name="rovio" output="screen" clear_params="true">
    <param name="filter_config" value="$(find rovio)/cfg/jacamar/rovio.info"/>
    <param name="camera0_config" value="$(find rovio)/cfg/jacamar/cam0.yaml"/>
    <!-- <param name="camera1_config" value="$(find rovio)/cfg/jacamar/cam1.yaml"/> -->

    <remap from="imu0" to="/vectornav_driver_node/imu/data"/>
    <remap from="cam0/image_raw" to="/d455/infra1/image_rect_raw"/>
    <remap from="radar" to="/radar/cloud"/>
    <!-- <remap from="cam1/image_raw" to="/d455/infra2/image_rect_raw"/> -->
  </node>
</launch>
